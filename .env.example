# OpenRouter (server-side only, preferred)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=google/gemini-2.5-flash
LLM_RELAY_URL=https://your-relay.example/api/llm-relay
LLM_RELAY_TOKEN=generate-a-long-random-token

# Optional YandexGPT fallback
YANDEX_CLOUD_FOLDER_ID=your-folder-id
YANDEX_CLOUD_API_KEY=your-api-key
# Or use a short-lived IAM token instead of an API key:
# YANDEX_CLOUD_IAM_TOKEN=your-iam-token
